# ---- Local LLM (OpenAI-compatible endpoint) ----
# Foundry Local:  http://localhost:5272/v1   (api key can be any dummy string)
# Ollama:         http://localhost:11434/v1
LLM_BASE_URL=http://localhost:5272/v1
LLM_API_KEY=foundry-local
LLM_MODEL=phi-4

# ---- Embeddings ----
EMBEDDING_MODEL=BAAI/bge-m3

# ---- GitHub (primary data source) ----
# For the demo, point at large public Microsoft repos, no special access needed.
GITHUB_TOKEN=
GITHUB_REPOS=microsoft/vscode,microsoft/TypeScript

# ---- Azure DevOps (optional, if the internship grants access) ----
ADO_ORG=
ADO_PROJECT=
ADO_PAT=

# ---- Storage ----
DUCKDB_PATH=./data/watchtower.duckdb
CHROMA_PATH=./data/chroma

# ---- Microsoft Teams webhook (proactive alerts) ----
# Incoming-webhook URL for the channel that should receive adaptive cards.
# Leave empty to run without notifications (they become a logged warning).
TEAMS_WEBHOOK_URL=

# ---- Background refresh ----
# collect -> roll up -> detect -> verify -> resolve -> notify
SCHEDULER_ENABLED=true
REFRESH_INTERVAL_MINUTES=30
# Weekly digest, in UTC.
DIGEST_DAY_OF_WEEK=mon
DIGEST_HOUR=8

# ---- Optional sprint goal used by the resolver's on-goal reasoning ----
SPRINT_GOAL=

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
